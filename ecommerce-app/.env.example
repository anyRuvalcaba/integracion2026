# URL base de la API (Create React App requiere el prefijo REACT_APP_).
# Incluye /api al final — apiClient.js no lo agrega.
#
# Local:      http://localhost:4000/api
# Producción: https://URL-DEL-BACKEND.onrender.com/api
#
# En desarrollo, el valor real vive en .env.development (versionado, valores locales
# no sensibles). Para sobreescribirlo sin tocar ese archivo, copiá este .env.example
# como .env.local (ignorado por git) y ajustá el valor.
# En Render, configurá esta variable en el servicio del frontend: se incorpora al
# bundle durante el build, así que un cambio de URL requiere reconstruir y redeployar.
REACT_APP_API_URL=http://localhost:4000/api
