# Entorno de ejecución: development | production
NODE_ENV=development

# Puerto local de la API (en Render lo asigna la plataforma automáticamente)
PORT=4000

MONGODB_URI=mongodb://localhost:27017/ecommerce-db-test

# URL principal del frontend (usada como valor por defecto de CORS_ALLOWED_ORIGINS si no se define)
FRONTEND_URL=http://localhost:3000

# Orígenes permitidos por CORS, separados por comas (sin espacios extra necesarios, se recortan igual)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=secret_token
JWT_REFRESH_TOKEN=secret_refresh_token
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
